#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec "$ROOT/toolchain/run" sh -eu -c '
  unformatted=$(gofmt -l cmd internal scripts)
  if [ -n "$unformatted" ]; then
    echo "gofmt needed:" >&2
    echo "$unformatted" >&2
    exit 1
  fi
  go vet ./...
  go test -race ./...
  sh scripts/e2e.sh
'
